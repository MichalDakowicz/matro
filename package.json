{
  "name": "matro",
  "version": "0.7.5",
  "description": "Matro desktop, web and native mobile media player monorepo.",
  "main": "apps/desktop/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test --test-concurrency=1 tests/media.test.cjs tests/segments.test.cjs tests/segment-scheduler.test.cjs tests/metadata.test.cjs tests/ssh-media.test.cjs tests/torrents.test.cjs tests/download-layout.test.cjs tests/movie-upgrades.test.cjs tests/subtitles.test.cjs tests/series.test.cjs tests/playback.test.cjs tests/desktop-source.test.cjs",
    "test:e2e": "playwright test",
    "icons": "node scripts/build-icons.cjs",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win nsis",
    "dev:web": "npm run dev --workspace @matro/web",
    "build:web": "npm run build --workspace @matro/web",
    "start:server": "npm run start --workspace @matro/server",
    "start:mobile": "npm run start --workspace @matro/mobile",
    "test:core": "node --test --test-concurrency=1 tests/media.test.cjs tests/segments.test.cjs tests/segment-scheduler.test.cjs tests/metadata.test.cjs tests/ssh-media.test.cjs tests/torrents.test.cjs tests/download-layout.test.cjs tests/movie-upgrades.test.cjs tests/subtitles.test.cjs tests/series.test.cjs tests/playback.test.cjs tests/desktop-source.test.cjs",
    "test:server": "npm run test --workspace @matro/server",
    "typecheck:mobile": "npm run typecheck --workspace @matro/mobile",
    "test:mobile": "npm test --workspace @matro/mobile",
    "pretest:e2e": "npm run build:web",
    "start:receiver": "electron . --server"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0"
  },
  "build": {
    "electronDist": "node_modules/electron/dist",
    "appId": "org.matro.player",
    "productName": "Matro",
    "directories": {
      "output": "dist"
    },
    "files": [
      "apps/desktop/**/*",
      "packages/core/**/*",
      "packages/browser-ui/**/*",
      "assets/icon.png",
      "assets/icon.ico",
      "package.json",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "licenses/**/*"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/ffprobe-static/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico"
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "vite": "^7.2.2"
  },
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
