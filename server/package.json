{
  "name": "matro-server",
  "version": "0.1.0",
  "description": "Self-hosted Matro: a web library and player with accounts, per-user watch state and shared subtitles.",
  "main": "src/index.js",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node scripts/sync-ui.js && node src/index.js",
    "dev": "node scripts/sync-ui.js && node scripts/dev.js",
    "sync-ui": "node scripts/sync-ui.js",
    "setup": "node src/cli.js setup",
    "test": "node --test --test-concurrency=1 test/"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0"
  },
  "bin": {
    "matro-server": "src/cli.js"
  }
}
